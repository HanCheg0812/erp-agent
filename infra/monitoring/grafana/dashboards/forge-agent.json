{
  "uid": "forge-agent",
  "title": "Forge ERP Agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API metrics",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"forge-api\"}"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "orientation": "auto"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active workers",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(forge_agent_worker_active)"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "orientation": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 8}]}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cube and Forge probes",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"forge-http\"}", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostgreSQL pool availability",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"refId": "A", "expr": "forge_api_database_pool_available", "legendFormat": "available"}, {"refId": "B", "expr": "forge_api_database_pool_waiting", "legendFormat": "waiting"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Firing alerts",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "orientation": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Host filesystem free ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"refId": "A", "expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}", "legendFormat": "root free %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}

# Run npm run dev:init to generate local-only credentials in .env.
POSTGRES_USER=erp_agent
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=erp_agent
POSTGRES_PORT=55432
DATABASE_URL=postgresql://erp_agent:replace-with-random-local-password@127.0.0.1:55432/erp_agent
RUSTFS_ACCESS_KEY=erp_agent_local
RUSTFS_SECRET_KEY=replace-with-a-second-random-local-secret
RUSTFS_REGION=us-east-1
RUSTFS_S3_PORT=9020
RUSTFS_CONSOLE_PORT=9021
RUSTFS_ENDPOINT=http://127.0.0.1:9020
# Local TEI container. CPU by default; use embedding:up:gpu after NVIDIA
# Container Toolkit is installed. The worker runs on the host for now.
TEI_PORT=8080
TEI_MODEL_ID=BAAI/bge-m3
TEI_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RAG_EMBEDDING_URL=http://127.0.0.1:8080
RAG_EMBEDDING_MODEL_ID=bge-m3
API_HOST=127.0.0.1
API_PORT=3100
DEMO_TENANT=demo
DEMO_EMAIL=planner@example.test
DEMO_PASSWORD=replace-with-random-demo-password
# Optional local Cube lifecycle. The base template does not run JCode yet.
CUBE_API_URL=http://127.0.0.1:3001
CUBE_OPS_URL=http://127.0.0.1:3010
CUBE_PROXY_URL=http://127.0.0.1
CUBE_TEMPLATE_ID=tpl-erp-agent-base-20260921
CUBE_QUANTITY_TEMPLATE_ID=
# Optional bounded browser adapter. Keep this list exact; no wildcard hosts.
CUBE_BROWSER_TEMPLATE_ID=
CUBE_BROWSER_ALLOWED_HOSTS=
CUBE_BROWSER_DOMAIN=cube.app
# Runtime management accepts digest-pinned candidate images only from this prefix.
FORGE_RUNTIME_IMAGE_PREFIX=127.0.0.1:5000/forge-agent-runtime:
# Temporary fixed-command Bash environment probe; keep disabled by default.
AGENT_TEMP_BASH_PROBE=0
# Match the Cube guest's IPv4 nameserver in /etc/resolv.conf.
CUBE_DNS_RESOLVER=169.254.254.53
# Model credentials go in gitignored .runtime/deepseek.env, not this example.
# DEEPSEEK_API_KEY=<dedicated-key>
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# JCode uses the selected model's context window as the session budget.
# AGENT_COMPACTION_SOFT_RATIO=0.80
# AGENT_COMPACTION_CRITICAL_RATIO=0.90
# Optional total turn deadline; 0 disables it (default).
# AGENT_TURN_TIMEOUT_SECONDS=0
# Set to 0 on the HTTP process when running separate `npm run dev:worker` processes.
# AGENT_WORKER_ENABLED=0
# Maximum active turns per worker process (1-8, default 4).
# AGENT_MAX_CONCURRENT_RUNS=4
# Per-process PostgreSQL pool. Standalone workers default to 12; API defaults to 16.
# Must exceed the worker's concurrent run slots. Include Cube guest and LISTEN connections in the node budget.
# DATABASE_POOL_MAX_SIZE=12
